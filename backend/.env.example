# PAEOS-FX backend configuration (copy to .env; NEVER commit real secrets).
# All variables are prefixed with PAEOS_.

# --- Application ---
PAEOS_ENVIRONMENT=development
PAEOS_DEBUG=true
PAEOS_APP_NAME=PAEOS-FX

# --- Database (PostgreSQL + PostGIS) ---
PAEOS_DATABASE_URL=postgresql+psycopg://paeos:paeos@localhost:5432/paeos
PAEOS_DB_ECHO=false

# --- Security ---
# Generate a strong secret for non-dev environments, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAEOS_JWT_SECRET=change-me-in-production
PAEOS_JWT_ALGORITHM=HS256
PAEOS_JWT_ACCESS_TTL_SECONDS=3600

# --- Localization ---
PAEOS_DEFAULT_LOCALE=en
PAEOS_DEFAULT_TIMEZONE=Asia/Manila
PAEOS_DEFAULT_CURRENCY=PHP

# --- Jobs / cache ---
PAEOS_REDIS_URL=redis://localhost:6379/0

# --- Observability ---
PAEOS_LOG_LEVEL=INFO
PAEOS_LOG_JSON=true
